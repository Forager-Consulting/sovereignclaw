{
  "display_information": {
    "name": "Sir Clawsalot",
    "description": "The castle's steward, reachable by direct message."
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": { "display_name": "Sir Clawsalot", "always_online": true }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["app_mentions:read", "channels:read", "groups:read", "chat:write", "im:history", "im:read", "im:write", "users:read"]
    }
  },
  "settings": {
    "socket_mode_enabled": true,
    "event_subscriptions": { "bot_events": ["app_home_opened", "app_mention", "message.im"] },
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
